  "observations": {
    "J": {
      "basis": "I A scelta nella 1.260 e confronto tecnico J_01 candidato, non utilizzato come geometria primaria.",
      "observed": "Il segno di 153v resta j/i lunga/indice irrisolto; cerchio e raggio del peso non appartengono al disegno. La J alfabetica è un completamento moderno.",
      "A": "Testa curva coordinata con I A e uncino inferiore ampio, senza punto.",
      "B": "Asola superiore piccola e uncino inferiore più gestuale; da distinguere da cifra 3 e g."
    },
    "K": {
      "basis": "Tre etichette tecniche K di 2v e 5r, di caso irrisolto, conservate dal precedente studio.",
      "observed": "Asta, braccio alto breve e gamba ricurva; le linee del meccanismo sono contesto e non contorni della lettera.",
      "A": "Struttura capitale leggibile, bracci lievemente curvi e innesto aperto.",
      "B": "Asola nell’asta, braccio alto compatto e gamba arcuata, coordinati con H B; ampliamento capitale progettato."
    },
    "U": {
      "basis": "Due u minuscole revisionate, 2r e 3r; non attestano una U capitale autonoma.",
      "observed": "Ritmo obliquo, raccordo inferiore e minimi diseguali. Le proporzioni capitali e la separazione moderna U/V sono progettate.",
      "A": "Curva inferiore continua e corpo aperto, più sobrio.",
      "B": "Asola iniziale e fondo più angoloso ma ancora curvo, coerente con H B e u B."
    },
    "V": {
      "basis": "Due etichette candidate v/u/o del 18v, senza una V capitale revisionata.",
      "observed": "Piccolo ritorno ovale e diagonale: l’identità del richiamo e il caso restano candidati. Posizione dell’asola e valle capitale sono progettate.",
      "A": "Due diagonali appena curve e valle netta, distinta dalla U.",
      "B": "Asola alta sul braccio destro e valle netta, coerenti con la v minuscola già scelta."
    },
    "W": {
      "basis": "Sintesi contemporanea da U/V e dalla w già scelta; nessun campione diretto W selezionato.",
      "observed": "Non viene presentata una W manoscritta: la doppia struttura e il ritorno sono un progetto di repertorio. Le assenze nella selezione non dimostrano assenza in tutti i manoscritti.",
      "A": "Doppia valle ampia e raccordi morbidi, senza asola.",
      "B": "Doppio ritmo diseguale e asola sul braccio destro, coordinati con V B; verificare la densità nelle parole."
    },
    "X": {
      "basis": "Due incroci tecnici candidati X/x del 18v; lettura e caso non promossi.",
      "observed": "Due direzioni diseguali e terminali differenti, con confini incerti. Non si deduce la sequenza dei tratti.",
      "A": "Incrocio centrale chiaro e diagonali morbide.",
      "B": "Incrocio più alto, direzioni curve e uscita inferiore più lunga; struttura leggibile progettata."
    },
    "Y": {
      "basis": "Candidata Y_01 del 153v, ambigua con h, e confronto della famiglia U/V.",
      "observed": "La candidata non certifica una Y a forcella. La biforcazione capitale, il peso e il piede restano costruzioni contemporanee.",
      "A": "Forcella aperta, asta semplice e contrasto chiaro con V.",
      "B": "Forcella asimmetrica e ritorno al piede; più gestuale ma con rischio di enfasi nel terminale."
    },
    "Z": {
      "basis": "Due z minuscole revisionate, 4r e 4v, senza capitale completa confermata.",
      "observed": "Cambi di direzione, breve raccordo centrale e ritorno inferiore; non si assume che una z minuscola ingrandita sia una capitale storica.",
