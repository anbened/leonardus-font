  "observations": {
    "C": {
      "basis": "Due c minuscole revisionate del Madrid I 1r, compresa l’iniziale del passo Considera: il registro conserva il caso minuscolo.",
      "observed": "Corpo basso aperto e terminali diseguali. L’ampliamento a capitale e il contrasto dei fianchi sono costruzioni moderne; nessuna C capitale indipendente selezionata.",
      "A": "Arco aperto regolare, estremità sobrie e corpo ampio.",
      "B": "Corpo più obliquo, terminale alto più corto e ritorno inferiore più marcato."
    },
    "D": {
      "basis": "Titolo De denti delle rote nel 1v e d minuscola revisionata nel 2r.",
      "observed": "Corpo chiuso e movimento curvo dell’asta; il piccolo segno del titolo non stabilisce una D capitale autonoma. Occhiello capitale e proporzioni sono progettati.",
      "A": "D dal corpo largo, fianchi morbidi e attacco semplice.",
      "B": "Attacco arrotondato, asta più curva e occhiello obliquo, coordinato con la R B scelta."
    },
    "E": {
      "basis": "Forma E aperta nel passo E alcuna volta, Madrid I 1v, e minuscola revisionata nel 3r.",
      "observed": "Arco sinistro, traversa e due aperture: è il confronto nuovo più utile. Caso, connessioni e contorno autonomo restano irrisolti; nessun accento è ricavato dal campione.",
      "A": "Tre terminali leggibili e asta lievemente curva.",
      "B": "Forma aperta simile a epsilon, con due archi e una traversa breve. È ed É seguono la stessa base progettata."
    },
    "G": {
      "basis": "g minuscole revisionate nei folii 2r e 4r. Nessuna G maiuscola indipendente selezionata.",
      "observed": "Occhiello e ritorno a cappio della minuscola suggeriscono continuità e direzione del raccordo. Il corpo C e la barra o il ricciolo della G restano scelte moderne, senza attestazione di capitale.",
      "A": "Corpo aperto e barra corta chiaramente leggibile.",
      "B": "Ritorno interno a spirale, più gestuale; controllare la distinzione da C e dalla cifra 6."
    },
    "P": {
      "basis": "Iniziale Perché del 1r, di caso non revisionato, e p minuscola revisionata nello stesso folio.",
      "observed": "Asta lunga, ingresso curvo e occhiello ridotto; l’ampio occhiello della P capitale è una scelta di leggibilità. La prosecuzione vicina non è copiata.",
      "A": "Occhiello aperto nel ritmo ma chiuso nel contorno e asta sobria.",
      "B": "Occhiello obliquo e piccolo ritorno sotto il piede, mantenendo leggibile la P."
    },
    "T": {
      "basis": "Iniziale del passo Tutte le molli nel 4r, non revisionata, e t minuscola già registrata nel 1r.",
      "observed": "Breve croce bassa. Non è un modello pronto per una T alta: traversa, altezza e peso delle proposte sono moderni. Il segno superiore di Il peso non è usato come T.",
      "A": "Traversa appena curva e asta continua.",
      "B": "Traversa arcuata, asta più mobile e ritorno al piede."
    }
  },
