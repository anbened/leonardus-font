  "observations": {
    "L": {
      "basis": "Iniziale Le rote (1v) ed etichetta L (18v), Madrid I. Letture e confini nuovi da confermare.",
      "observed": "Asta curva e ritorno superiore; piede breve nel confronto. Altezza capitale, spessore e piede leggibile sono scelte moderne.",
      "A": "Asta curva con ingresso breve e piede moderatamente aperto.",
      "B": "Piccola asola superiore e piede più mobile, senza riprodurre la e vicina."
    },
    "A": {
      "basis": "Confronti in Madrid I 1v e 2v: iniziale a ovale ed etichetta aperta; nessuna A capitale autonoma confermata.",
      "observed": "Apertura a tetto e asimmetria del segno tecnico; l’iniziale del testo è di caso incerto. Due aste, traversa e controforma della A proposta sono costruite per lettura moderna.",
      "A": "Apice arrotondato, due fianchi diseguali e traversa bassa.",
      "B": "Ingresso più obliquo, traversa inclinata e ritorno al piede destro."
    },
    "M": {
      "basis": "Iniziale Ma sse (153v di lavoro) e m minuscola già registrata (2r).",
      "observed": "Spalle curve di altezza diversa; il manoscritto non offre qui le proporzioni della nostra M tipografica. Ampliare il segno a capitale è una reinterpretazione.",
      "A": "M con sommità morbide e valle centrale ancora angolare.",
      "B": "Due spalle molto diverse e valle curva: la soluzione più corsiva."
    },
    "N": {
      "basis": "Confronto con n minuscola registrata nel 2r; nessuna N capitale indipendente selezionata nei 30 fogli disponibili.",
      "observed": "Ingresso e spalla curva della n suggeriscono il ritmo. Il segno a fondo del diagramma nel 12r è compatibile con K ed è escluso come modello di N. Diagonale e altezza della N restano costruzioni moderne.",
      "A": "Diagonale curva e attacco sobrio, riconoscibilità convenzionale.",
      "B": "Ingresso ritornante e diagonale più concava; forma più stretta a parità di avanzamento."
    },
    "R": {
      "basis": "r minuscola registrata nel 2r ed etichetta r di caso incerto nel 2v; nessuna R capitale completa selezionata.",
      "observed": "Spalla breve e angolare. Occhiello superiore e gamba discendente della R proposta non sono attestati da questi confronti: sono raccordi moderni.",
      "A": "Occhiello leggibile, raccordo angoloso e gamba con uscita breve.",
      "B": "Occhiello più obliquo, spalla aperta nel ritmo e gamba con ritorno finale."
    },
    "S": {
      "basis": "s lunga registrata nel 2r e segno sinuoso nel diagramma del 1r, trascritto S da e-Leo ma non confermato come sagoma autonoma.",
      "observed": "La lunga asta della minuscola e il segno tecnico non equivalgono a una S maiuscola pronta. Il doppio arco aperto è una sintesi moderna per distinguere S da f e dalla cifra 2.",
      "A": "Due archi aperti e distribuzione più regolare dei pieni.",
      "B": "Testa raccolta, vita più verticale e arco inferiore più largo."
    }
  },
