  "observations": {
    "a": {
      "observed": "Nei cinque bersagli il nucleo è spesso una capanna stretta e aperta in basso; chiusura e appartenenza delle connessioni restano incerte.",
      "A": "Corpo chiuso più angoloso, vertice alto e controforma obliqua; chiusura inferiore conservata per leggibilità.",
      "B": "Capanna aperta con gamba destra obliqua; manca la pancia chiusa. Rischio esplicito di lettura come n.",
      "primary": [
        "BNE_MI_014_A_03",
        "BNE_MI_016_A_01",
        "BNE_MI_016_A_04"
      ]
    },
    "e": {
      "observed": "Elemento superiore piccolo, spesso separato nel raster, sopra un corpo basso obliquo e prolungato verso la lettera vicina. Non si ricostruisce la continuità dell’inchiostro.",
      "A": "Occhio più piccolo e alto, arco inferiore alleggerito e uscita lunga; raccordo continuo progettato.",
      "B": "Occhio alto compatto e piccolo uncino sopra una fascia obliqua aperta; raccordo superiore e fascia sono disegnati per evitare un segno simile a due punti.",
      "primary": [
        "BNE-MI-018-e-02",
        "BNE-MI-018-e-03",
        "BNE-MI-020-e-06"
      ]
    },
