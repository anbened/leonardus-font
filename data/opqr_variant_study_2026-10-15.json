  "evidence": "data/glyph_evidence.csv",
  "evidence_sha256": "9132b71b937a217159dd328f8c770f9daeebc6f53320763bcd62fb7708bc8cf7",
  "observations": {
    "o": {
      "observed": "Chiusure spesso appuntite, controforme oblique e asimmetria fra fianco sinistro e ritorno destro nei campioni di 2r e 3r; non ricorre un unico ovale regolare.",
      "A": "Ovale asimmetrico con vertice superiore contenuto e controforma obliqua chiusa.",
      "B": "Vertice e cambio di direzione superiore più marcati; corpo più stretto e angoloso.",
      "limits": "Non si deducono pressione, ordine dei tratti o misure esatte da crop di 15-26 pixel. Chiusura, peso e dimensioni sono progettati.",
      "primary": [
        "BNE_MI_016_O_01",
        "BNE_MI_016_O_02",
        "BNE_MI_018_O_04",
        "BNE_MI_018_O_06"
      ]
    },
    "p": {
      "observed": "P02 e p03 hanno testa contenuta nella parte alta e asta lunga; p04 offre una variante a bandiera aperta. La p della 1.200 ha una pancia più bassa e regolare.",
      "A": "Testa chiusa più piccola e alta, con discendente relativamente più lunga; mantiene una lettura moderna di p.",
      "B": "Testa a bandiera aperta verso il basso, distinta dalla p chiusa; variante esplorativa basata su p04.",
      "limits": "P05 e p09 esclusi dalle ancore geometriche principali; non si copia il piede inferiore incerto. La discendente è contenuta nelle metriche del font, anziché riprodurne integralmente la lunghezza storica.",
      "primary": [
        "BNE_MI_EXP_014_P_02",
        "BNE_MI_EXP_016_P_03",
        "BNE_MI_EXP_016_P_04"
      ]
    },
    "q": {
      "observed": "Q01 presenta una testa ripiegata aperta e discendente destra. Q02 è una variante distinta con cappio e coda curva; non rappresenta tutte le q del gruppo.",
      "A": "Testa ridotta, controforma aperta in basso a destra e discendente diritta. La curva sinistra è ampliata rispetto al breve uncino di q01 per preservare la lettura moderna.",
      "B": "Testa chiusa alta e coda curva a destra, come interpretazione separata di q02; non proposta come forma storica generale.",
      "limits": "Q03/q04/q05 restano dubbi per confini ed estremi e non guidano la geometria principale. Il ponte orizzontale verso il vicino non diventa una traversa della q. Apertura e coda sono disegnate, senza ricalco.",
      "primary": [
        "BNE_MI_EXP_014_Q_01",
        "BNE_MI_EXP_014_Q_02"
      ]
    },
    "r": {
      "observed": "Nei campioni di 1r, 2r, 3r e 4r ricorre un attacco biforcato, con ramo sinistro obliquo e spalla destra breve, più vicino a una forcella che all'asta con arco della 1.200.",
      "A": "Forcella contenuta nella parte alta, spalla breve e asta riconoscibile; riduce il rischio di lettura come v o y.",
      "B": "Ramo sinistro più alto e biforcazione più profonda; gesto più evidente ma maggiore rischio di ambiguità nella lettura.",
      "limits": "R04 non guida il disegno principale: il token è irrisolto. Nessuna ricostruzione del ductus, nessuna nuova approvazione delle connessioni.",
      "primary": [
        "BNE-MI-016-r-01",
        "BNE-MI-014-r-02",
        "BNE-MI-014-r-03",
        "BNE-MI-018-r-05",
        "BNE-MI-020-r-06"
      ]
    }
  },
