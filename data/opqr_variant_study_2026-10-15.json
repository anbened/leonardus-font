{
  "schema_version": 1,
  "date": "2026-10-15",
  "status": "unapproved_design_variants_for_comparison",
  "scope": "opqr_only",
  "instruction_quote": "Procedi con il confronto di o, p, q e r con i campioni storici e prepara varianti più aderenti ai tratti osservati, mantenendole leggibili. Mostrami poi il confronto dentro parole reali.",
  "human_visual_design_approval": false,
  "integration_approved": false,
  "authenticity_claim": false,
